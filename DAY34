#include <stdio.h>

int main() {
    int arr[100], n, element, pos;

    printf("Enter array size: ");
    scanf("%d", &n);

    printf("Enter array elements:\n");

    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    printf("Enter element: ");
    scanf("%d", &element);

    printf("Enter position: ");
    scanf("%d", &pos);

    if (pos < 1 || pos > n + 1 || n >= 100) {
        printf("Invalid position or array full");
        return 0;
    }

    for (int i = n; i >= pos; i--) {
        arr[i] = arr[i - 1];
    }

    arr[pos - 1] = element;
    n++;

    printf("Updated array: ");

    for (int i = 0; i < n; i++) {
        printf("%d ", arr[i]);
    }

    return 0;
}
