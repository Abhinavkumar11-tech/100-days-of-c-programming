#include <stdio.h>

int main() {
    int a[10][10], r, c;

    printf("Enter rows and columns: ");
    scanf("%d %d", &r, &c);

    printf("Enter matrix elements:\n");

    for (int i = 0; i < r; i++) {
        for (int j = 0; j < c; j++) {
            scanf("%d", &a[i][j]);
        }
    }

    printf("Diagonal traversal:\n");

    for (int k = 0; k < r + c - 1; k++) {

        int row = (k < r) ? k : r - 1;
        int col = k - row;

        while (row >= 0 && col < c) {
            printf("%d ", a[row][col]);
            row--;
            col++
        }
    }

    return 0;
}
