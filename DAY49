#include <stdio.h>

int main() {
    int a[10][10], n, sum = 0;

    printf("Enter matrix size: ");
    scanf("%d", &n);

    printf("Enter matrix elements:\n");

    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            scanf("%d", &a[i][j]);
        }
    }

    for (int i = 0; i < n; i++) {
        sum += a[i][i];
    }

    printf("Main diagonal sum = %d", sum);

    return 0;
} 
