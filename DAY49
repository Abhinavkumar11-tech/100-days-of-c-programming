#include <stdio.h>

int main() {
    int a[10][10], n, flag = 1;

    printf("Enter matrix size: ");
    scanf("%d", &n);

    printf("Enter matrix elements:\n");

    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            scanf("%d", &a[i][j]);
        }
    }

    for (int i = 0; i < n; i++) {
        for (int j = i + 1; j < n; j++) {

            if (i == j || i + j == n - 1) {
                if (a[i][i] == a[j][j] ||
                    a[i][n - 1 - i] == a[j][n - 1 - j]) {
                    flag = 0;
                }
            }
        }
    }

    // Check common elements between both diagonals.
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            if ((i == j || i + j == n - 1) &&
                (i != j || n % 2 == 0)) {
                if (a[i][i] == a[j][n - 1 - j] &&
                    i != j) {
                    flag = 0;
                }
            }
        }
    }

    if (flag)
        printf("Diagonal elements are distinct");
    else
        printf("Diagonal elements are not distinct");

    return 0;
}
