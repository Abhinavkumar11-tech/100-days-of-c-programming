#include <stdio.h>

int main() {
    char name[100];

    printf("Enter full name: ");
    fgets(name, sizeof(name), stdin);

    printf("Initials: ");

    for (int i = 0; name[i] != '\0'; i++) {

        if (i == 0 && name[i] != ' ') {
            printf("%c.", name[i]);
        }
        else if (name[i] == ' ' &&
                 name[i + 1] != ' ' &&
                 name[i + 1] != '\0' &&
                 name[i + 1] != '\n') {
            printf("%c.", name[i + 1]);
        }
    }

    return 0;
}
