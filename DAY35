#include <stdio.h>

int main() {
    int arr[100], n;
    int largest, second;
    int found = 0;

    printf("Enter array size: ");
    scanf("%d", &n);

    printf("Enter elements:\n");

    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    largest = arr[0];

    for (int i = 1; i < n; i++) {
        if (arr[i] > largest) {
            largest = arr[i];
        }
    }

    for (int i = 0; i < n; i++) {
        if (arr[i] < largest) {
            if (!found || arr[i] > second) {
                second = arr[i];
                found = 1;
            }
        }
    }

    if (found)
        printf("Second largest = %d", second);
    else
        printf("Second largest does not exist");

    return 0;
}
