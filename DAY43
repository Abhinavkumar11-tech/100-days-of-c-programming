#include <stdio.h>

int main() {
    char str[100];
    int len = 0, flag = 1;

    printf("Enter a string: ");
    fgets(str, sizeof(str), stdin);

    while (str[len] != '\0' && str[len] != '\n') {
        len++;
    }

    int start = 0;
    int end = len - 1;

    while (start < end) {

        if (str[start] != str[end]) {
            flag = 0;
            break;
        }

        start++;
        end--;
    }

    if (flag)
        printf("Palindrome String");
    else
        printf("Not a Palindrome String");

    return 0;
}
