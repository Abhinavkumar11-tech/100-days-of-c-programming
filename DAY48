#include <stdio.h>

int main() {
    char s[100], t[100];
    int len1 = 0, len2 = 0;
    int flag = 0;

    printf("Enter first string: ");
    scanf("%99s", s);

    printf("Enter second string: ");
    scanf("%99s", t);

    while (s[len1] != '\0')
        len1++;

    while (t[len2] != '\0')
        len2++;

    if (len1 == len2) {

        for (int k = 0; k < len1; k++) {

            int match = 1;

            for (int j = 0; j < len1; j++) {
                if (s[(k + j) % len1] != t[j]) {
                    match = 0;
                    break;
                }
            }

            if (match) {
                flag = 1;
                break;
            }
        }
    }

    if (flag)
        printf("Strings are rotations");
    else
        printf("Strings are not rotations");

    return 0;
}
96#include <stdio.h>

int main() {
    char str[200];
    int start = 0, i = 0;

    printf("Enter a sentence: ");
    fgets(str, sizeof(str), stdin);

    while (1) {

        if (str[i] == ' ' || str[i] == '\n' ||
            str[i] == '\0') {

            int end = i - 1;

            while (start < end) {
                char temp = str[start];
                str[start] = str[end];
                str[end] = temp;

                start++;
                end--;
            }

            if (str[i] == '\0' || str[i] == '\n')
                break;

            start = i + 1;
        }

        i++;
    }

    printf("Result: %s", str);

    return 0;
}
