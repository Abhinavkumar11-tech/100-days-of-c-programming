#include <stdio.h>

int main() {
    int n, flag;

    printf("Enter n: ");
    scanf("%d", &n);

    printf("Prime numbers: ");

    for (int i = 2; i <= n; i++) {

        flag = 1;

        for (int j = 2; j <= i / j; j++) {
            if (i % j == 0) {
                flag = 0;
                break;
            }
        }

        if (flag == 1) {
            printf("%d ", i);
        }
    }

    return 0;
}
