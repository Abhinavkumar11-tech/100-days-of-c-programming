#include <stdio.h>

int main() {
    int a[100], b[100], c[200];
    int n, m, i;

    printf("Enter size of first array: ");
    scanf("%d", &n);

    printf("Enter first array elements:\n");

    for (i = 0; i < n; i++) {
        scanf("%d", &a[i]);
        c[i] = a[i];
    }

    printf("Enter size of second array: ");
    scanf("%d", &m);

    printf("Enter second array elements:\n");

    for (i = 0; i < m; i++) {
        scanf("%d", &b[i]);
        c[n + i] = b[i];
    }

    printf("Merged array: ");

    for (i = 0; i < n + m; i++) {
        printf("%d ", c[i]);
    }

    return 0;
}
Q64
#include <stdio.h>

int main() {
    long long n;
    int freq[10] = {0};
    int digit, max = 0, result = 0;

    printf("Enter a number: ");
    scanf("%lld", &n);

    if (n < 0)
        n = -n;

    if (n == 0)
        freq[0]++;

    while (n > 0) {
        digit = n % 10;
        freq[digit]++;
        n /= 10;
    }

    for (int i = 0; i < 10; i++) {
        if (freq[i] > max) {
            max = freq[i];
            result = i;
        }
    }

    printf("Most frequent digit = %d", result);

    return 0;
}
