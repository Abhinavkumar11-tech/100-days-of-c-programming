#include <stdio.h>

int main() {
    char a[100], b[100];
    int freq[256] = {0};
    int flag = 1;

    printf("Enter first string: ");
    scanf("%99s", a);

    printf("Enter second string: ");
    scanf("%99s", b);

    for (int i = 0; a[i] != '\0'; i++) {
        freq[(unsigned char)a[i]]++;
    }

    for (int i = 0; b[i] != '\0'; i++) {
        freq[(unsigned char)b[i]]--;
    }

    for (int i = 0; i < 256; i++) {
        if (freq[i] != 0) {
            flag = 0;
            break;
        }
    }

    if (flag)
        printf("Anagram");
    else
        printf("Not Anagram");

    return 0;
}
Q94
#include <stdio.h>

int main() {
    char str[200];
    int i = 0, start = 0;
    int maxLen = 0, maxStart = 0;

    printf("Enter a sentence: ");
    fgets(str, sizeof(str), stdin);

    while (1) {

        if (str[i] == ' ' || str[i] == '\n' ||
            str[i] == '\0' || str[i] == '\t') {

            int len = i - start;

            if (len > maxLen) {
                maxLen = len;
                maxStart = start;
            }

            if (str[i] == '\0' || str[i] == '\n')
                break;

            start = i + 1;
        }

        i++;
    }

    printf("Longest word: ");

    for (int j = maxStart; j < maxStart + maxLen; j++) {
        printf("%c", str[j]);
    }

    printf("\nLength = %d", maxLen);

    return 0;
}

