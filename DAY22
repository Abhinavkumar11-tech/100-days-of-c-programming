#include <stdio.h>

int main() {
    int n, temp, rem, fact, sum = 0;

    printf("Enter a number: ");
    scanf("%d", &n);

    temp = n;

    while (temp > 0) {
        rem = temp % 10;
        fact = 1;

        for (int i = 1; i <= rem; i++) {
            fact *= i;
        }

        sum += fact;
        temp /= 10;
    }

    if (n >= 0 && sum == n)
        printf("Strong Number");
    else
        printf("Not a Strong Number");

    return 0;
}
Q44
#include <stdio.h>

int main() {
    int n;
    float sum = 0;

    printf("Enter number of terms: ");
    scanf("%d", &n);

    for (int i = 1; i <= n; i++) {
        sum += (float)(2 * i - 1) / (2 * i);
    }

    printf("Sum = %.2f", sum);

    return 0;
}
